{
  "name": "html-markdown-editor",
  "version": "0.5.1",
  "scripts": {
    "prepublishOnly": "rimraf dist/tsconfig.tsbuildinfo",
    "test": "tsc --noEmit",
    "clean": "rimraf dist",
    "build": "esbuild --bundle src/app.ts --outdir=dist/ --format=esm --minify --splitting",
    "tsc": "tsc -p .",
    "dev": "npm run build -- --watch"
  },
  "keywords": [
    "html",
    "markdown",
    "editor",
    "llm",
    "markdown-editor",
    "html-editor",
    "markdown-to-html",
    "html-to-markdown",
    "web-ui"
  ],
