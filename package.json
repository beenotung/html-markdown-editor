  "type": "commonjs",
  "description": "",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "rimraf": "^6.1.4",
    "surge": "^0.56.0",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "micromark": "^4.0.3",
