{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "incremental": true,
    "declaration": true,
    "lib": ["es2022", "dom"],
    "rootDir": ".",
    "types": ["mocha", "chai", "node"],
    "outDir": "dist"
  },
  "include": ["src", "test"],
  "exclude": ["dist"]
}
